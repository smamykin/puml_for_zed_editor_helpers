#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA="$JAVA_HOME/bin/java"
else
    JAVA=""
    for candidate in \
        /opt/homebrew/opt/openjdk/bin/java \
        /opt/homebrew/opt/openjdk@21/bin/java \
        /Applications/GoLand.app/Contents/jbr/Contents/Home/bin/java \
        '/Applications/JetBrains Toolbox.app/Contents/jre/Contents/Home/bin/java'; do
        if [ -x "$candidate" ]; then
            JAVA="$candidate"
            break
        fi
    done
fi
if [ -z "$JAVA" ]; then
    echo 'Java not found. Set JAVA_HOME to a JDK installation.' >&2
    exit 1
fi
if [ -x /opt/homebrew/bin/dot ]; then
    export GRAPHVIZ_DOT=/opt/homebrew/bin/dot
fi
exec "$JAVA" -Dfile.encoding=UTF-8 -jar "$SCRIPT_DIR/plantuml.jar" "$@"
